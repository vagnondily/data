{
  "manifest_version": 3,
  "name": "RAKETA — Capture de téléchargements",
  "version": "0.4.0",
  "description": "Envoie les liens, téléchargements et vidéos vers RAKETA (clic droit « Télécharger » / « Récupérer la vidéo », ou capture automatique).",
  "permissions": ["contextMenus", "downloads", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1:47623/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "RAKETA"
  }
}
